# ==========================================
# Scout System - Environment Variables
# ==========================================

# Environment mode: development / staging / production
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-scout-system-dev-secret-key-change-in-production-2026

# Allowed Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database configuration (PostgreSQL in production/Docker, SQLite default in local dev if DB_ENGINE not set)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://scout_admin:scout_secure_pass_2026@localhost:5432/scout_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & Sessions
SESSION_COOKIE_AGE=86400
MAX_LEADER_SESSIONS=2

# Backup Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
BACKUP_ENCRYPTION_KEY=dGhpcy1pcy1hLWR1bW15LWtleS1mb3ItZGV2ZWxvcG1lbnQ=

# Storage Limits (in MegaBytes)
MAX_IMAGE_SIZE_MB=10
MAX_DOC_SIZE_MB=25

# Media & Static Storage
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
